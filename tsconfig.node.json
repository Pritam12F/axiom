{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/types/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@main/*": ["./src/main/*"] 
    },
    "moduleResolution": "bundler",
  },
   "declaration": false,
   "composite": false
}

